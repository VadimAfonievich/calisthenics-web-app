POSTGRES_DB=calisthenics
POSTGRES_USER=calisthenics
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://calisthenics:replace-with-a-long-random-password@postgres:5432/calisthenics?sslmode=disable
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBAPP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
LOG_LEVEL=INFO
OBJECT_STORAGE_PROVIDER=unavailable
OBJECT_STORAGE_ENDPOINT=https://s3-compatible-endpoint.example.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=replace-with-bucket
OBJECT_STORAGE_ACCESS_KEY=replace-with-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-secret-key
OBJECT_STORAGE_PUBLIC_URL=https://media.example.com
