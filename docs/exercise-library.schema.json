{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calisthenics.coach/schemas/exercise-library.schema.json",
  "title": "Persisted exercise library record",
  "type": "object",
  "required": ["id","name","slug","description","instructions","common_mistakes","difficulty","muscle_groups","equipment","movement_type","status","owner_user_id"],
  "properties": {
    "id": {"type":"string","format":"uuid"},
    "name": {"type":"string","minLength":1},
    "slug": {"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "description": {"type":"string","minLength":1},
    "instructions": {"type":"string","minLength":1},
    "common_mistakes": {"type":"string"},
    "difficulty": {"enum":["beginner","intermediate","advanced"]},
    "muscle_groups": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "equipment": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "movement_type": {"enum":["reps","duration","distance","custom"]},
    "tags": {"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "coach_tips": {"type":"string"},
    "video_url": {"type":["string","null"],"format":"uri"},
    "image_url": {"type":["string","null"],"format":"uri"},
    "cover_media_id": {"type":["string","null"],"format":"uuid"},
    "owner_user_id": {"type":["string","null"],"format":"uuid","description":"null means immutable system content"},
    "status": {"enum":["draft","published","archived"]},
    "published_at": {"type":["string","null"],"format":"date-time"},
    "published_by": {"type":["string","null"],"format":"uuid"}
  },
  "additionalProperties": false
}
